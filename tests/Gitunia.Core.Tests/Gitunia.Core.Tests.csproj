<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests read docs/ux-*.md; the output folder may be outside the repo (ArtifactsPath on CI), so no walking up from it (#663). -->
    <AssemblyMetadata Include="RepoRoot" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared git speed settings (#624): one source file, linked instead of a project reference between test projects. -->
    <Compile Include="..\Gitunia.Git.Tests\Fixtures\TestGitSpeed.cs" Link="Fixtures\TestGitSpeed.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Status entries and working-tree states for tests, owned by Gitunia.Tui.Tests. -->
    <Compile Include="..\Gitunia.Tui.Tests\Rendering\WorkingTree\WorkingTreeEntries.cs" Link="Shared\WorkingTreeEntries.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The renderer of docs/keymap.md, linked from the generator so a test can check the committed file is current (#868). -->
    <Compile Include="..\..\tools\KeymapDoc\KeymapReference.cs" Link="Keymap\KeymapReference.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gitunia.Core\Gitunia.Core.csproj" />
  </ItemGroup>
</Project>
