<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>gitunia</AssemblyName>
    <RootNamespace>Gitunia.Tui</RootNamespace>
    <PublishAot>true</PublishAot>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- IL* warnings fail the build via the global TreatWarningsAsErrors. -->
  </PropertyGroup>
  <!-- Bakes $(Version) into a constant (no reflection on assembly attributes, nothing to read at startup). -->
  <Target Name="GenerateBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildVersionFile>$(IntermediateOutputPath)BuildVersion.g.cs</BuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildVersionFile)" Lines="namespace Gitunia.Tui%3B internal static class BuildVersion { public const string Value = &quot;$(Version)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildVersionFile)" />
      <FileWrites Include="$(BuildVersionFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <ProjectReference Include="..\Gitunia.App\Gitunia.App.csproj" />
    <ProjectReference Include="..\Gitunia.Core\Gitunia.Core.csproj" />
    <ProjectReference Include="..\Gitunia.Platform\Gitunia.Platform.csproj" />
  </ItemGroup>
</Project>
