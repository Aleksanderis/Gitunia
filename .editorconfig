root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# Always use 'var' for locals.
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning

# CancellationToken is always the last parameter.
dotnet_diagnostic.CA1068.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Unused usings fail the build.
dotnet_diagnostic.IDE0005.severity = warning

# Local constants are camelCase (Rider "Local constants" rule).
dotnet_naming_rule.local_constants_camel.symbols = local_constants
dotnet_naming_rule.local_constants_camel.style = camel_case_style
dotnet_naming_rule.local_constants_camel.severity = warning

dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Deconstruct as `var (a, b) =`, not `(var a, var b) =`.
csharp_style_deconstructed_variable_declaration = true:warning

# Collection expressions, method groups instead of forwarding lambdas.
dotnet_style_prefer_collection_expression = true:warning
csharp_style_prefer_method_group_conversion = true:warning
dotnet_diagnostic.IDE0200.severity = warning

# Unused locals and values, needless suppressions (`!`, pragmas, attributes).
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0370.severity = warning

# Pass the CancellationToken on to the calls that accept one.
dotnet_diagnostic.CA2016.severity = warning

# A blank line after a closing brace before the next statement.
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning
dotnet_diagnostic.IDE2003.severity = warning

# Wrap lines that run past 120 columns (Rider and `dotnet format` honour it).
max_line_length = 120

# Private and protected instance fields are _camelCase (consts and statics excluded).
dotnet_naming_rule.instance_fields_underscore.symbols = instance_fields
dotnet_naming_rule.instance_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.instance_fields_underscore.severity = warning

dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = private, protected, private_protected, protected_internal

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Consts and statics keep their own naming.
dotnet_naming_rule.static_fields_any.symbols = static_fields
dotnet_naming_rule.static_fields_any.style = any_style
dotnet_naming_rule.static_fields_any.severity = none

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_style.any_style.capitalization = pascal_case

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
