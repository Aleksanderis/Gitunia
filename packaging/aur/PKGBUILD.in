# Maintainer: Gitunia maintainers <noreply@users.noreply.github.com>
# Template: packaging/aur/update.sh fills @VERSION@, @SHA256_X64@ and @SHA256_ARM64@ from the release (#944).
pkgname=gitunia-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Keyboard-first terminal Git client (graph, branches, worktrees, vim-style keys)'
arch=('x86_64' 'aarch64')
url='https://github.com/Aleksanderis/Gitunia'
license=('MIT')
depends=('git')
provides=('gitunia')
conflicts=('gitunia')
source_x86_64=("gitunia-$pkgver-linux-x64.tar.gz::$url/releases/download/v$pkgver/gitunia-$pkgver-linux-x64.tar.gz")
source_aarch64=("gitunia-$pkgver-linux-arm64.tar.gz::$url/releases/download/v$pkgver/gitunia-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local rid=linux-x64
  [ "$CARCH" = aarch64 ] && rid=linux-arm64
  cd "gitunia-$pkgver-$rid"
  install -Dm755 gitunia "$pkgdir/usr/bin/gitunia"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
