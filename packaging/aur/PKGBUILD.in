# Maintainer: Gitunia maintainers <noreply@users.noreply.github.com>
# Template: packaging/aur/update.sh fills @VERSION@ and @SHA256@ from the release (#944).
pkgname=gitunia-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Keyboard-first terminal Git client (graph, branches, worktrees, vim-style keys)'
arch=('x86_64')
url='https://github.com/Aleksanderis/Gitunia'
license=('MIT')
depends=('git')
provides=('gitunia')
conflicts=('gitunia')
source=("gitunia-$pkgver-linux-x64.tar.gz::$url/releases/download/v$pkgver/gitunia-$pkgver-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "gitunia-$pkgver-linux-x64"
  install -Dm755 gitunia "$pkgdir/usr/bin/gitunia"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
